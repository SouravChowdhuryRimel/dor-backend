model Driver {
  driverId             String          @id @default(uuid()) @map("driver_id")
  phoneNumber          String          @map("phone_number")
  password             String
  email                String          @unique
  driverImage          String?         @map("driver_image")
  driverName           String          @map("driver_name")
  address              String
  district             String
  upozela              String?
  lat                  Float?
  long                 Float?
  truckNumber          String?         @map("truck_number")
  truckType            String?         @map("truck_type")
  loadCapacity         String?         @map("load_capacity")
  drivingLicenceNumber String          @map("driving_licence_number")
  nidNumber            String          @map("nid_number")
  driverDocument       String[]        @map("driver_document")
  isVerified           Boolean         @default(false) @map("is_verified")
  fcmToken                  String?         @map("fcm_token")
  isPushNotificationEnabled Boolean         @default(true) @map("is_push_notification_enabled")
  companyDrivers            CompanyDriver[]
  partyDrivers         PartyDriver[]
  deliveries           Delivery[]
  complaints           Complaint[]
  activityLogs         ActivityLog[]
  notifications        Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("drivers")
}
