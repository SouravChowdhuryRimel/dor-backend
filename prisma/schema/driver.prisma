model Driver {
    driverId       String     @id @default(uuid()) @map("driver_id")
    phoneNumber    String     @map("phone_number")
    password       String
    email          String     @unique
    driverDocument String[]   @map("driver_document")
    deliveries     Delivery[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("drivers")
}
