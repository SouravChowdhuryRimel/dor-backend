model Category {
  categoryId        String         @id @default(uuid()) @map("category_id")
  categoryName      String         @map("category_name")
  categoryThumbnail String?        @map("category_thumbnail")
  status            CategoryStatus @default(ACTIVE)
  companies         Company[]
  parties           Party[]
  drivers           Driver[]
  adminCategories   AdminCategory[]
  inquiries         Inquiry[]

  @@map("categories")
}
