model Company {
  companyId       String          @id @default(uuid()) @map("company_id")
  phoneNumber     String          @map("phone_number")
  password        String
  companyName     String          @map("company_name")
  ownerName       String          @map("owner_name")
  email           String          @unique
  district        String?
  upozela         String?
  latitude        Float?
  longitude       Float?
  address         String
  status          CompanyStatus   @default(PENDING)
  isVerified      Boolean         @default(false) @map("is_verified")
  incomeTax       String?         @map("income_tax")
  companyDocument String[]        @map("company_document")
  companyImage    String?         @map("company_image")
  fcmToken        String?         @map("fcm_token")
  categoryId      String          @map("category_id")
  category        Category        @relation(fields: [categoryId], references: [categoryId])
  adminId         String?         @map("admin_id")
  admin           User?           @relation(fields: [adminId], references: [id])
  orders          Order[]
  parties         Party[]
  companyDrivers  CompanyDriver[]
  complaints      Complaint[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  products        Product[]
  inquiryResponses InquiryResponse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}
