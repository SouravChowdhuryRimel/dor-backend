model Party {
    partyId       String   @id @default(uuid()) @map("party_id")
    partyName     String   @map("party_name")
    businessName  String   @map("business_name")
    phoneNumber   String   @unique @map("phone_number")
    email         String   @unique
    password      String
    address       String
    district      String
    upozela       String
    bazzarArea    String   @map("bazzar_area")
    description   String
    openingDue    Float    @map("opening_due")
    creditLimit   Float    @map("credit_limit")
    status        String   @default("ACTIVE")
    partyDocument String[] @map("party_document")
    profileImage  String?  @map("profile_image")
    offers        Offer[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("parties")
}
