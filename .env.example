# ==============================================================================
# Price Check BD - Environment Configuration Template
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=pricecheck_db
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/pricecheck_db?schema=public
DB_POOL_MAX=20

# JWT Authentication & Token Rotation
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_replace_in_production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Redis Cache & Socket.io Pub/Sub Adapter
REDIS_HOST=localhost
REDIS_PORT=6379

# Queue Redis (BullMQ / Background Workers)
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379

# Default Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@pricecheckbd.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure2026!

# SMTP Email Dispatcher (OTP / Notifications)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Price Check BD" <no-reply@pricecheckbd.com>

# Firebase Cloud Messaging (FCM) - Mobile Push Notifications
FIREBASE_PROJECT_ID=price-check-bd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@price-check-bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# CORS Configuration
CORS_ORIGIN=*
